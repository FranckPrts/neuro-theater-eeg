/* global WEBGL, CENTER, RGB, loadModel, createCanvas, resizeCanvas, windowWidth, windowHeight */
/* global background, ambientLight, directionalLight, orbitControl, push, pop, rotateX, rotateY, rotateZ */
/* global scale, model, text, textAlign, textSize, noStroke, fill, noFill, constrain, millis, sin, TWO_PI, PI */
/* global pointLight, spotLight, emissiveMaterial, sphere, translate, stroke, strokeWeight, line */
/* global ambientMaterial, specularMaterial, shininess, specularColor, lightFalloff, colorMode */

// Brain 3D model credit: https://sketchfab.com/3d-models/brain-7a2c96d2bc5c4068b3f715fd5ed95b67
const BRAIN_MODEL_PATH = "p5-misc/glass-brain/brain2.obj";
const BRAIN_SCALE = 0.0045;
const SCROLL_ZOOM_SENSITIVITY = 0.85;

const MARKER_LIGHT_POWER = 120;
const MARKER_SPOT_POWER = 255;
const MARKER_SPOT_ANGLE = Math.PI / 3;
const MARKER_SPOT_CONCENTRATION = 24;
const MARKER_OUTWARD_BIAS = 16;
const MARKER_GLOW_RADIUS = 5.35;
const LIGHT_FALLOFF = { constant: 1, linear: 0.001, quadratic: 0 };

const SCENE_AMBIENT_LIGHT = [28, 34, 58];
const SCENE_KEY_LIGHT = [55, 62, 88];
const SCENE_KEY_DIRECTION = [-0.4, 0.35, -1];

const BRAIN_AMBIENT_MATERIAL = [10, 22, 62];
const BRAIN_SPECULAR_MATERIAL = [255, 255, 255];
const BRAIN_SHININESS = 24;
const BRAIN_ROTATION_X = -0.18;

const DATA_INTENSITY_MIN = 0.2;
const DATA_INTENSITY_MAX = 2.5;
const DATA_STALE_MS = 2000;
const LIGHT_PULSE_PERIOD_MS = 2000;

/** Per-marker last value and time of last change (for stale detection). */
const markerDataState = {};

const AXIS_VECTOR_LENGTH = 108;
const AXIS_LABEL_OFFSET = 3.5;
const AXIS_DOT_RADIUS = 0.7;

/** Set false when done tuning lamp position / aim */
const DEBUG_LAMP = true;
const DEBUG_CONTACT_SPHERE_RADIUS = 2.5;
const DEBUG_LAMP_WIREFRAME_RADIUS = 1.8;
const DEBUG_AIM_LINE_LENGTH = 45;

const MUSE_COLOR = [80, 220, 255];
const MONTAGE_BACK_TILT_RADIANS = Math.PI / 6;
const LIGHT_MARKERS = [
  { id: "TP9", color: MUSE_COLOR, position: [-68, -12, 32], radius: 1.35 },
  { id: "TP10", color: MUSE_COLOR, position: [68, -12, 32], radius: 1.35 },
  { id: "AF7", color: MUSE_COLOR, position: [-46, 60, 4], radius: 1.35 },
  { id: "AF8", color: MUSE_COLOR, position: [46, 70, 4], radius: 1.35 },
];

let brainModel;
let autoRotation = 0;
let orientation = { roll: 0, pitch: 0, yaw: 0 };
let hasOrientation = false;

const DEG_TO_RAD = Math.PI / 180;
const RAD_TO_DEG = 180 / Math.PI;

function readNumber(id, fallback = null) {
  const raw = data?.[id];
  return typeof raw === "number" && isFinite(raw) ? raw : fallback;
}

function quaternionModeEnabled() {
  return data?.quaternion_mode === true;
}

function readEulerDegrees() {
  const roll = readNumber("IMU1");
  const pitch = readNumber("IMU2");
  const yaw = readNumber("IMU3");
  if ([roll, pitch, yaw].some((v) => v === null)) return null;
  return { roll, pitch, yaw };
}

function readQuaternionXyzw() {
  let x = readNumber("IMU1");
  let y = readNumber("IMU2");
  let z = readNumber("IMU3");
  let w = readNumber("IMU4");
  if ([x, y, z, w].some((v) => v === null)) return null;

  const mag = Math.sqrt(x * x + y * y + z * z + w * w);
  if (!isFinite(mag) || mag <= 0) return null;
  x /= mag;
  y /= mag;
  z /= mag;
  w /= mag;
  return { x, y, z, w };
}

function quaternionToEulerDegrees(q) {
  const { x, y, z, w } = q;

  const sinrCosp = 2 * (w * x + y * z);
  const cosrCosp = 1 - 2 * (x * x + y * y);
  const roll = Math.atan2(sinrCosp, cosrCosp) * RAD_TO_DEG;

  const sinp = 2 * (w * y - z * x);
  const pitch = Math.abs(sinp) >= 1
    ? Math.sign(sinp) * 90
    : Math.asin(sinp) * RAD_TO_DEG;

  const sinyCosp = 2 * (w * z + x * y);
  const cosyCosp = 1 - 2 * (y * y + z * z);
  const yaw = Math.atan2(sinyCosp, cosyCosp) * RAD_TO_DEG;

  return { roll, pitch, yaw };
}

function updateOrientationFromComputedData() {
  let next = null;
  if (quaternionModeEnabled()) {
    const q = readQuaternionXyzw();
    if (q) next = quaternionToEulerDegrees(q);
  } else {
    next = readEulerDegrees();
  }
  if (!next) return;
  orientation = next;
  hasOrientation = true;
}

function sceneRotationEnabled() {
  const raw = data?.rotation;
  if (raw === undefined || raw === null || raw === "") return true;
  if (typeof raw === "boolean") return raw;
  if (typeof raw === "number") return raw !== 0;

  const normalized = String(raw).trim().toLowerCase();
  if (["0", "false", "no", "off"].includes(normalized)) return false;
  if (["1", "true", "yes", "on"].includes(normalized)) return true;
  return true;
}

function referentialUtilityEnabled() {
  if (typeof data?.referential_utility === "boolean") return data.referential_utility;
  if (typeof data?.referential_utility === "number") return data.referential_utility !== 0;
  const s = String(data?.referential_utility ?? "").trim().toLowerCase();
  if (["0", "false", "no", "off"].includes(s)) return false;
  if (["1", "true", "yes", "on"].includes(s)) return true;
  return true;
}

preload = () => {
  brainModel = loadModel(BRAIN_MODEL_PATH, true);
};

windowResized = () => {
  resizeCanvas(windowWidth, windowHeight);
};

setup = () => {
  createCanvas(windowWidth, windowHeight, WEBGL);
  textAlign(CENTER, CENTER);
  colorMode(RGB, 255);
};

function withBrainTransform(drawFn) {
  push();
  rotateX(BRAIN_ROTATION_X);
  if (hasOrientation) {
    rotateZ(orientation.yaw * DEG_TO_RAD);
    rotateY(orientation.pitch * DEG_TO_RAD);
    rotateX(orientation.roll * DEG_TO_RAD);
  } else {
    rotateZ(autoRotation);
  }
  scale(brainWorldScale());
  drawFn();
  pop();
}

function brainWorldScale() {
  return Math.min(width, height) * BRAIN_SCALE;
}

function rotateZPoint([x, y, z], angle) {
  const c = Math.cos(angle);
  const s = Math.sin(angle);
  return [x * c - y * s, x * s + y * c, z];
}

function rotateYPoint([x, y, z], angle) {
  const c = Math.cos(angle);
  const s = Math.sin(angle);
  return [x * c + z * s, y, -x * s + z * c];
}

function rotateXPoint([x, y, z], angle) {
  const c = Math.cos(angle);
  const s = Math.sin(angle);
  return [x, y * c - z * s, y * s + z * c];
}

function applyBrainRotations(point) {
  if (hasOrientation) {
    return rotateXPoint(
      rotateZPoint(
        rotateYPoint(
          rotateXPoint(point, orientation.roll * DEG_TO_RAD),
          orientation.pitch * DEG_TO_RAD
        ),
        orientation.yaw * DEG_TO_RAD
      ),
      BRAIN_ROTATION_X
    );
  }
  return rotateXPoint(rotateZPoint(point, autoRotation), BRAIN_ROTATION_X);
}

function brainPointToWorld(point) {
  const s = brainWorldScale();
  return applyBrainRotations(point.map((v) => v * s));
}

function brainDirectionToWorld(direction) {
  return applyBrainRotations(direction);
}

function oscillatingLightFactor() {
  const phase = ((millis() % LIGHT_PULSE_PERIOD_MS) / LIGHT_PULSE_PERIOD_MS) * TWO_PI;
  const u = 0.5 + 0.5 * sin(phase);
  return DATA_INTENSITY_MIN + u * (DATA_INTENSITY_MAX - DATA_INTENSITY_MIN);
}

function mapDataToIntensity(raw) {
  const n = constrain(raw, 0, 1);
  return DATA_INTENSITY_MIN + n * (DATA_INTENSITY_MAX - DATA_INTENSITY_MIN);
}

function updateMarkerDataState(markerId, value) {
  const now = millis();
  const state = markerDataState[markerId];
  if (!state) {
    markerDataState[markerId] = { lastValue: value, changedAt: now };
    return;
  }
  if (value !== state.lastValue) {
    state.lastValue = value;
    state.changedAt = now;
  }
}

function isMarkerDataFresh(markerId) {
  const state = markerDataState[markerId];
  if (!state) return false;
  return millis() - state.changedAt < DATA_STALE_MS;
}

function markerIntensity(marker) {
  const raw = data?.[marker.id];
  if (typeof raw !== "number" || !isFinite(raw)) {
    return constrain(oscillatingLightFactor(), 0, 1);
  }
  const value = constrain(raw, 0, 1);
  updateMarkerDataState(marker.id, value);
  if (isMarkerDataFresh(marker.id)) {
    return mapDataToIntensity(value);
  }
  return constrain(oscillatingLightFactor(), 0, 1);
}

function markerContactPosition(marker) {
  const [x, y, z] = marker.position;
  const c = Math.cos(MONTAGE_BACK_TILT_RADIANS);
  const s = Math.sin(MONTAGE_BACK_TILT_RADIANS);
  return [x, y * c - z * s, y * s + z * c];
}

function markerLampPosition(marker) {
  const [x, y, z] = markerContactPosition(marker);
  const mag = Math.sqrt(x * x + y * y + z * z) || 1;
  return [
    x + (x / mag) * MARKER_OUTWARD_BIAS,
    y + (y / mag) * MARKER_OUTWARD_BIAS,
    z + (z / mag) * MARKER_OUTWARD_BIAS,
  ];
}

function inwardFromLamp(lx, ly, lz) {
  const mag = Math.sqrt(lx * lx + ly * ly + lz * lz) || 1;
  return [-lx / mag, -ly / mag, -lz / mag];
}

function addEmitterLights() {
  lightFalloff(LIGHT_FALLOFF.constant, LIGHT_FALLOFF.linear, LIGHT_FALLOFF.quadratic);
  for (const marker of LIGHT_MARKERS) {
    const i = markerIntensity(marker);
    if (i <= 0) continue;
    const lampPosition = markerLampPosition(marker);
    const [lx, ly, lz] = brainPointToWorld(lampPosition);
    const [dx, dy, dz] = brainDirectionToWorld(inwardFromLamp(...lampPosition));
    const [r, g, b] = marker.color;
    const spotP = i * MARKER_SPOT_POWER;
    const pointP = i * MARKER_LIGHT_POWER;

    spotLight(
      (r / 255) * spotP,
      (g / 255) * spotP,
      (b / 255) * spotP,
      lx,
      ly,
      lz,
      dx,
      dy,
      dz,
      MARKER_SPOT_ANGLE,
      MARKER_SPOT_CONCENTRATION
    );

    if (debugPointLightsEnabled()) {
      pointLight((r / 255) * pointP, (g / 255) * pointP, (b / 255) * pointP, lx, ly, lz);
    }
  }
}

function drawBrainModel() {
  withBrainTransform(() => {
    noStroke();
    ambientMaterial(...BRAIN_AMBIENT_MATERIAL);
    specularMaterial(...BRAIN_SPECULAR_MATERIAL);
    shininess(BRAIN_SHININESS);
    model(brainModel);
  });
}

function debugLampEnabled() {
  if (typeof data?.debug_lamp === "boolean") return data.debug_lamp;
  if (typeof data?.debug_lamp === "number") return data.debug_lamp !== 0;
  const s = String(data?.debug_lamp ?? "").trim().toLowerCase();
  if (["0", "false", "no", "off"].includes(s)) return false;
  if (["1", "true", "yes", "on"].includes(s)) return true;
  return DEBUG_LAMP;
}

function debugPointLightsEnabled() {
  if (typeof data?.debug_point_lights === "boolean") return data.debug_point_lights;
  if (typeof data?.debug_point_lights === "number") return data.debug_point_lights !== 0;
  const s = String(data?.debug_point_lights ?? "").trim().toLowerCase();
  return ["1", "true", "yes", "on"].includes(s);
}

function drawLampDebug() {
  if (!debugLampEnabled()) return;
  withBrainTransform(() => {
    strokeWeight(0.4);
    for (const marker of LIGHT_MARKERS) {
      const [cx, cy, cz] = markerContactPosition(marker);
      const [lx, ly, lz] = markerLampPosition(marker);
      const [dx, dy, dz] = inwardFromLamp(lx, ly, lz);
      const [r, g, b] = marker.color;

      stroke(255, 220, 80, 210);
      push();
      translate(cx, cy, cz);
      noFill();
      sphere(DEBUG_CONTACT_SPHERE_RADIUS, 10, 8);
      pop();

      stroke(80, 255, 255, 220);
      push();
      translate(lx, ly, lz);
      noFill();
      sphere(DEBUG_LAMP_WIREFRAME_RADIUS, 10, 8);
      pop();

      stroke(255, 220, 80, 170);
      line(cx, cy, cz, lx, ly, lz);

      stroke(r, g, b, 220);
      line(lx, ly, lz, lx + dx * DEBUG_AIM_LINE_LENGTH, ly + dy * DEBUG_AIM_LINE_LENGTH, lz + dz * DEBUG_AIM_LINE_LENGTH);
    }

    stroke(140, 140, 150, 140);
    const o = 5;
    line(-o, 0, 0, o, 0, 0);
    line(0, -o, 0, 0, o, 0);
    line(0, 0, -o, 0, 0, o);
  });
}

function drawLightMarkers() {
  withBrainTransform(() => {
    noStroke();
    for (const marker of LIGHT_MARKERS) {
      const i = markerIntensity(marker);
      if (i <= 0) continue;
      const [r, g, b] = marker.color;
      const [lx, ly, lz] = markerLampPosition(marker);
      const glow = 0.45 + i * 0.55;
      push();
      translate(lx, ly, lz);
      emissiveMaterial(r * glow, g * glow, b * glow, 255);
      sphere(MARKER_GLOW_RADIUS * glow, 20, 20);
 
      pop();
    }
  });
}

function drawMinimalXyzVector() {
  if (!referentialUtilityEnabled()) return;
  withBrainTransform(() => {
    const length = AXIS_VECTOR_LENGTH;
    const label = length + AXIS_LABEL_OFFSET;
    const tickValues = [25, 50, 75, 100];
    const axes = [
      {
        label: "X axis",
        color: [255, 75, 90],
        end: [length, 0, 0],
        text: [label, 0, 0],
        tickMark: (value) => [value, -2, 0, value, 2, 0],
        tickText: (value) => [value, -6, 0],
      },
      {
        label: "Y axis",
        color: [92, 255, 126],
        end: [0, length, 0],
        text: [0, label, 0],
        tickMark: (value) => [-2, value, 0, 2, value, 0],
        tickText: (value) => [6, value, 0],
      },
      {
        label: "Z axis",
        color: [78, 160, 255],
        end: [0, 0, length],
        text: [0, 0, label],
        tickMark: (value) => [-2, 0, value, 2, 0, value],
        tickText: (value) => [6, 0, value],
      },
    ];

    strokeWeight(0.55);
    for (const axis of axes) {
      const [r, g, b] = axis.color;
      const [x, y, z] = axis.end;
      stroke(r, g, b, 220);
      line(0, 0, 0, x, y, z);

      for (const value of tickValues) {
        stroke(r, g, b, 170);
        line(...axis.tickMark(value));

        push();
        translate(...axis.tickText(value));
        fill(r, g, b, 210);
        noStroke();
        textSize(3.5);
        text(String(value), 0, 0);
        pop();
      }

      push();
      translate(x, y, z);
      noStroke();
      emissiveMaterial(r, g, b, 255);
      sphere(AXIS_DOT_RADIUS, 8, 6);
      pop();

      push();
      translate(...axis.text);
      fill(r, g, b, 230);
      noStroke();
      textSize(5);
      text(axis.label, 0, 0);
      pop();
    }
  });
}

draw = () => {
  updateOrientationFromComputedData();
  background(8, 10, 16);

  orbitControl(1, 1, SCROLL_ZOOM_SENSITIVITY);
  if (!hasOrientation && sceneRotationEnabled()) autoRotation += 0.004;

  ambientLight(...SCENE_AMBIENT_LIGHT);
  directionalLight(...SCENE_KEY_LIGHT, ...SCENE_KEY_DIRECTION);
  specularColor(255, 255, 255, 255);

  addEmitterLights();

  drawBrainModel();
  drawLampDebug();
  drawLightMarkers();
  drawMinimalXyzVector();
};
