// Multi-channel view — reads fixed keys ch0..ch5 from `data` (mapped from OSC in the host).
const BG = [5, 5, 5];
const GRID = [10, 26, 10];
const SIGNAL = [0, 255, 159];
const SIGNAL_DIM = [0, 255, 159, 90];
const MUTED_TEXT = [0, 180, 120, 140];
const HEADER = "RAW EEG CHANNELS";
const fontSize = 10;
const labelColW = 54;
const headerH = 26;
const signalStroke = 1.25;
const trimRange = false;

const CHANNEL_IDS = ["ch0", "ch1", "ch2", "ch3", "ch4", "ch5"];
const CHANNEL_LABELS = ["AF3", "F3", "FC5", "C3", "P3", "O1"];

const DEFAULT_HISTORY = 500;
const DEFAULT_SCROLL = 4;

function historyLength() {
  const n = data?.__historyLength;
  return typeof n === "number" && Number.isFinite(n) ? Math.max(100, Math.floor(n)) : DEFAULT_HISTORY;
}

function scrollSpeed() {
  const n = data?.__scrollSpeed;
  return typeof n === "number" && Number.isFinite(n) ? Math.max(1, Math.min(20, Math.floor(n))) : DEFAULT_SCROLL;
}

function drawGlowingTimeSeries(ts, plotLeft, xRight, lowerbound, upperbound, span) {
  noFill();
  stroke(...SIGNAL_DIM);
  strokeWeight(signalStroke * 3.5);
  drawTimeSeries(ts, plotLeft, xRight, lowerbound, upperbound, span);
  stroke(...SIGNAL);
  strokeWeight(signalStroke);
  drawTimeSeries(ts, plotLeft, xRight, lowerbound, upperbound, span);
}

function drawTimeSeries(ts, plotLeft, xRight, lowerbound, upperbound, span) {
  const count = Math.min(ts.length, span);
  if (count < 2) return;
  const xSpan = xRight - plotLeft;
  beginShape();
  for (let j = 0; j < count; j++) {
    let v = ts[ts.length - count + j];
    if (trimRange) v = constrain(v, minimum, maximum);
    const x = plotLeft + (j / (count - 1)) * xSpan;
    vertex(x, map(v, minimum, maximum, upperbound, lowerbound));
  }
  endShape();
}

windowResized = () => {
  resizeCanvas(windowWidth, windowHeight);
};

let minimum = -0.5;
let maximum = 1.5;
const ts_channels = CHANNEL_IDS.map(() => []);

setup = () => {
  createCanvas(windowWidth, windowHeight);
  textSize(fontSize);
  textFont("Courier New");
};

draw = () => {
  background(...BG);

  fill(...SIGNAL);
  noStroke();
  textAlign(LEFT, TOP);
  textSize(fontSize);
  text(HEADER, 12, 8);

  const plotTop = headerH;
  const plotH = height - plotTop;
  const plotLeft = labelColW + 6;
  const plotW = width - plotLeft - 8;
  const xRight = plotLeft + plotW;
  const nSlots = CHANNEL_IDS.length;
  const rowH = plotH / nSlots;
  const span = historyLength();
  const speed = scrollSpeed();

  stroke(...GRID);
  strokeWeight(1);
  for (let i = 1; i < nSlots; i++) {
    const y = plotTop + i * rowH;
    line(plotLeft, y, width - 6, y);
  }

  let hasAny = false;
  for (let k = 0; k < CHANNEL_IDS.length; k++) {
    const id = CHANNEL_IDS[k];
    const raw = data?.[id];
    if (raw !== undefined && raw !== null && typeof raw === "number" && isFinite(raw)) {
      for (let s = 0; s < speed; s++) {
        ts_channels[k].push(raw);
      }
      while (ts_channels[k].length > span) {
        ts_channels[k].shift();
      }
      hasAny = true;
    }
  }

  if (!hasAny) {
    fill(...MUTED_TEXT);
    noStroke();
    textAlign(CENTER, CENTER);
    text("MAP OSC STREAMS TO CH0–CH5", width / 2, height / 2);
    return;
  }

  for (let k = 0; k < nSlots; k++) {
    const ts = ts_channels[k];
    const y0 = plotTop + k * rowH + 3;
    const y1 = plotTop + (k + 1) * rowH - 3;
    const midY = (y0 + y1) / 2;

    fill(...SIGNAL);
    noStroke();
    textAlign(LEFT, CENTER);
    textSize(fontSize);
    text(CHANNEL_LABELS[k], 10, midY);

    if (ts.length < 2) continue;

    push();
    drawingContext.save();
    drawingContext.beginPath();
    drawingContext.rect(plotLeft, y0, plotW, y1 - y0);
    drawingContext.clip();
    drawGlowingTimeSeries(ts, plotLeft, xRight, y0, y1, span);
    drawingContext.restore();
    pop();
  }
};
