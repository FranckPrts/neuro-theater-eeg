// ─────────────────────────────────────────────────────────────────────────────
// Time Series — Three Representations
// ─────────────────────────────────────────────────────────────────────────────

// ── Utility ──────────────────────────────────────────────────────────────────
function divideIfNotZero(numerator, denominator) {
  if (denominator === 0 || isNaN(denominator)) return 0;
  return numerator / denominator;
}

// ── Data ─────────────────────────────────────────────────────────────────────
let ts = [];                        // rolling time-series buffer
let ts_key = 'Time Series';         // key into the incoming `data` object

// ── Pause state ──────────────────────────────────────────────────────────────
let paused = false;

// ── Toggle state ─────────────────────────────────────────────────────────────
let showGraphs = { continuous: true, discrete: true, binary: true };
let toggles = [
  { key: 'continuous', label: 'Continuous', color: '#4fc3f7' },
  { key: 'discrete',   label: 'Discrete',   color: '#a5d6a7' },
  { key: 'binary',     label: 'Binary',     color: '#ef9a9a' },
];
let toggleRects = [];

// ── Representation parameters (edit these to tune the visualizations) ────────
let numBins   = 4;      // number of discrete levels for Graph 2
let threshold = 0.5;    // 0–1 decision boundary for Graph 3

// ── Layout constants (computed each frame in draw) ────────────────────────────
let marginLeft, marginRight, marginTop, marginBottom;
let graphWidth, graphHeight;
let originX;            // x of the vertical axis
let graphSpacing;       // vertical gap between graphs

// ─────────────────────────────────────────────────────────────────────────────
// P5 lifecycle
// ─────────────────────────────────────────────────────────────────────────────
windowResized = () => resizeCanvas(windowWidth, windowHeight);

setup = () => {
  createCanvas(windowWidth, windowHeight);
  textFont('monospace');
};

mousePressed = () => {
  for (let r of toggleRects) {
    if (mouseX >= r.x && mouseX <= r.x + r.w &&
        mouseY >= r.y && mouseY <= r.y + r.h) {
      if (r.key === '__pause__') {
        paused = !paused;
      } else {
        showGraphs[r.key] = !showGraphs[r.key];
      }
      break;
    }
  }
};

draw = () => {
  // ── Recompute layout every frame so it stays responsive ───────────────────
  marginLeft    = width  * 0.10;
  marginRight   = width  * 0.04;
  marginTop     = height * 0.06;
  marginBottom  = height * 0.04;
  graphSpacing  = height * 0.04;
  graphWidth    = width - marginLeft - marginRight;
  originX       = marginLeft;

  // ── Background ─────────────────────────────────────────────────────────────
  background(15, 15, 20);

  // ── Ingest new data sample (skipped when paused) ──────────────────────────
  if (!paused) {
    let raw = data?.[ts_key];
    if (raw !== undefined && raw !== null) {
      let sample = constrain(raw, 0, 1);
      ts.push(sample);
      if (ts.length > graphWidth) ts.shift();
    }
  }

  // ── Toggle list + pause button ─────────────────────────────────────────────
  toggleRects = [];
  noStroke();
  textFont('monospace');
  textSize(12);
  textAlign(LEFT, TOP);
  let tx = marginLeft;
  let ty = marginTop * 0.20;
  for (let tog of toggles) {
    let lbl = (showGraphs[tog.key] ? '\u25cf ' : '\u25cb ') + tog.label;
    let tw  = textWidth(lbl) + 10;
    toggleRects.push({ key: tog.key, x: tx, y: ty, w: tw, h: 16 });
    fill(showGraphs[tog.key] ? tog.color : color(80, 90, 110));
    text(lbl, tx, ty);
    tx += tw + 18;
  }
  // Pause button
  let pauseLbl = paused ? '\u25b6 Resume' : '\u23f8 Pause';
  let pauseW   = textWidth(pauseLbl) + 10;
  toggleRects.push({ key: '__pause__', x: tx, y: ty, w: pauseW, h: 16 });
  fill(paused ? color(255, 200, 80) : color(160, 160, 180));
  text(pauseLbl, tx, ty);

  // ── Dynamic layout (only visible panels) ───────────────────────────────────
  let panels = [
    { key: 'continuous', fn: drawContinuousGraph },
    { key: 'discrete',   fn: drawDiscreteGraph   },
    { key: 'binary',     fn: drawBinaryGraph      },
  ].filter(p => showGraphs[p.key]);

  let n = panels.length;
  if (n > 0) {
    graphHeight = (height - marginTop - marginBottom - graphSpacing * (n - 1)) / n;
    for (let i = 0; i < n; i++) {
      panels[i].fn(marginTop + i * (graphHeight + graphSpacing));
    }
  }

  // ── Parameter legend (bottom-right) ───────────────────────────────────────
  drawLegend();
};

// ─────────────────────────────────────────────────────────────────────────────
// GRAPH 1 — Continuous
// ─────────────────────────────────────────────────────────────────────────────
function drawContinuousGraph(gy) {
  drawAxes(gy, "CONTINUOUS", "#4fc3f7");

  if (ts.length < 2) return;

  stroke("#4fc3f7");
  strokeWeight(1.5);
  noFill();
  beginShape();
  for (let i = 0; i < ts.length; i++) {
    let x = originX + i;
    let y = map(ts[i], 0, 1, gy + graphHeight, gy);
    vertex(x, y);
  }
  endShape();

  // Subtle fill under the curve
  noStroke();
  fill(79, 195, 247, 25);
  beginShape();
  vertex(originX, gy + graphHeight);
  for (let i = 0; i < ts.length; i++) {
    let x = originX + i;
    let y = map(ts[i], 0, 1, gy + graphHeight, gy);
    vertex(x, y);
  }
  vertex(originX + ts.length - 1, gy + graphHeight);
  endShape(CLOSE);
}

// ─────────────────────────────────────────────────────────────────────────────
// GRAPH 2 — Discrete (binned / staircase)
// ─────────────────────────────────────────────────────────────────────────────
function drawDiscreteGraph(gy) {
  drawAxes(gy, "DISCRETE  (bins: " + numBins + ")", "#a5d6a7");

  // Draw bin-level gridlines
  stroke(80, 130, 80, 120);
  strokeWeight(0.5);
  for (let b = 0; b <= numBins; b++) {
    let y = map(b / numBins, 0, 1, gy + graphHeight, gy);
    line(originX, y, originX + graphWidth, y);
  }

  if (ts.length < 2) return;

  // Staircase rendering: quantise each sample to nearest bin
  stroke("#a5d6a7");
  strokeWeight(1.5);
  noFill();
  beginShape();
  for (let i = 0; i < ts.length; i++) {
    let quantised = round(ts[i] * numBins) / numBins;
    let x = originX + i;
    let y = map(quantised, 0, 1, gy + graphHeight, gy);
    vertex(x, y);
  }
  endShape();

  // Filled bars for current sample
  noStroke();
  fill(165, 214, 167, 30);
  beginShape();
  vertex(originX, gy + graphHeight);
  for (let i = 0; i < ts.length; i++) {
    let quantised = round(ts[i] * numBins) / numBins;
    let x = originX + i;
    let y = map(quantised, 0, 1, gy + graphHeight, gy);
    vertex(x, y);
  }
  vertex(originX + ts.length - 1, gy + graphHeight);
  endShape(CLOSE);
}

// ─────────────────────────────────────────────────────────────────────────────
// GRAPH 3 — Binary (threshold gate)
// ─────────────────────────────────────────────────────────────────────────────
function drawBinaryGraph(gy) {
  drawAxes(gy, "BINARY  (threshold: " + nf(threshold, 1, 2) + ")", "#ef9a9a");

  // Draw threshold line
  let threshY = map(threshold, 0, 1, gy + graphHeight, gy);
  stroke(239, 154, 154, 100);
  strokeWeight(1);
  setLineDash([6, 4]);
  line(originX, threshY, originX + graphWidth, threshY);
  setLineDash([]);

  // Label
  noStroke();
  fill(239, 154, 154, 160);
  textSize(10);
  textAlign(RIGHT, CENTER);
  text("θ", originX - 4, threshY);

  if (ts.length < 2) return;

  // Binary signal: 1 if sample > threshold, else 0
  stroke("#ef9a9a");
  strokeWeight(2);
  noFill();

  for (let i = 1; i < ts.length; i++) {
    let prevBit = ts[i - 1] > threshold ? 1 : 0;
    let currBit = ts[i]     > threshold ? 1 : 0;
    let x0 = originX + i - 1;
    let x1 = originX + i;
    let yPrev = map(prevBit, 0, 1, gy + graphHeight, gy + graphHeight * 0.1);
    let yCurr = map(currBit, 0, 1, gy + graphHeight, gy + graphHeight * 0.1);

    line(x0, yPrev, x1, yPrev);
    if (prevBit !== currBit) {
      line(x1, yPrev, x1, yCurr);
    }
  }

  // Fill
  noStroke();
  fill(239, 154, 154, 25);
  beginShape();
  vertex(originX, gy + graphHeight);
  for (let i = 0; i < ts.length; i++) {
    let bit = ts[i] > threshold ? 1 : 0;
    let x = originX + i;
    let y = map(bit, 0, 1, gy + graphHeight, gy + graphHeight * 0.1);
    vertex(x, y);
  }
  vertex(originX + ts.length - 1, gy + graphHeight);
  endShape(CLOSE);
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared axes helper
// ─────────────────────────────────────────────────────────────────────────────
function drawAxes(gy, label, accentColor) {
  // Border
  stroke(60, 65, 80);
  strokeWeight(1);
  noFill();
  rect(originX, gy, graphWidth, graphHeight);

  // Y-axis ticks & labels
  textAlign(RIGHT, CENTER);
  textSize(10);
  for (let t = 0; t <= 4; t++) {
    let frac = t / 4;
    let y = map(frac, 0, 1, gy + graphHeight, gy);
    stroke(60, 65, 80);
    strokeWeight(0.5);
    line(originX - 4, y, originX, y);
    noStroke();
    fill(130, 140, 160);
    text(nf(frac, 1, 1), originX - 7, y);
  }

  // Graph title / type label
  noStroke();
  fill(accentColor);
  textSize(11);
  textAlign(LEFT, BOTTOM);
  text(label, originX + 6, gy - 4);

  // Time arrow label
  fill(100, 110, 130);
  textSize(10);
  textAlign(RIGHT, TOP);
  text("time →", originX + graphWidth, gy + graphHeight + 3);
}

// ─────────────────────────────────────────────────────────────────────────────
// Parameter legend
// ─────────────────────────────────────────────────────────────────────────────
function drawLegend() {
  let lx = originX + graphWidth + 10;
  let ly = marginTop;
  let lw = marginRight * 0.9;

  noStroke();
  fill(100, 110, 130);
  textSize(10);
  textAlign(LEFT, TOP);

  fill(60, 65, 80);
  noStroke();
}

// ─────────────────────────────────────────────────────────────────────────────
// Canvas dashed-line helper (p5 doesn't expose this natively)
// ─────────────────────────────────────────────────────────────────────────────
function setLineDash(list) {
  drawingContext.setLineDash(list);
}