/**
 * Spider / radar plot — neon frequency-band aesthetic over the same OSC data model.
 *
 * Radius mode (from host `data`): `__radiusMode` — `relative` (default) or `absolute`.
 * Absolute scale: `__absoluteMean` (branch value at center), `__absoluteMax` (|v−mean| at outer edge).
 *
 * Max mappable overlays (OSC rail size). Server reads this exact line for /api/p5-scenes:
 *   const NUM_OVERLAY_PLOTS = 6;
 */
const NUM_OVERLAY_PLOTS = 6;

const ANGLE = (2 * Math.PI) / 5;
const ROTATION = -Math.PI / 2;
const RADIUS = 205;
const LABEL_R = 268;
const GRID_LEVELS = [0.25, 0.5, 0.75];

const BAND_NAMES = ["DELTA", "THETA", "ALPHA", "LOW BETA", "HIGH BETA"];
const BAND_FREQ = ["0.5–4 Hz", "4–8 Hz", "8–13 Hz", "13–20 Hz", "20–30 Hz"];
const BAND_COLORS = [
  [74, 144, 226],
  [76, 175, 80],
  [255, 152, 0],
  [211, 84, 0],
  [233, 30, 99],
];
const PLANET_BASE_COLORS = [
  "#F53645",
  "#F5A636",
  "#D0F536",
  "#36F563",
  "#36E3F5",
  "#3647F5",
  "#A136F5",
];
const EEG_RING_LABELS = [
  "Fp1", "F7", "T7", "P7", "O1", "O2", "P8", "T8",
  "F8", "Fp2", "F4", "C4", "P4", "Pz", "Cz", "Fz",
  "F3", "C3", "P3", "PO3", "AF3", "FC5", "FC1", "CP5",
  "CP1", "CP2", "CP6", "FC2", "FC6", "AF4", "PO4", "Oz",
];

function parseHexColor(h, fallback = [120, 160, 200]) {
  if (typeof h !== "string") return fallback;
  let s = h.trim();
  if (s.startsWith("0x")) s = "#" + s.slice(2);
  if (!s.startsWith("#")) s = "#" + s;
  const hex = s.slice(1);
  if (hex.length === 3) {
    const r = parseInt(hex[0] + hex[0], 16);
    const g = parseInt(hex[1] + hex[1], 16);
    const b = parseInt(hex[2] + hex[2], 16);
    if ([r, g, b].every((x) => !isNaN(x))) return [r, g, b];
  }
  if (hex.length === 6) {
    const r = parseInt(hex.slice(0, 2), 16);
    const g = parseInt(hex.slice(2, 4), 16);
    const b = parseInt(hex.slice(4, 6), 16);
    if ([r, g, b].every((x) => !isNaN(x))) return [r, g, b];
  }
  return fallback;
}

function planetColorForPlot(p) {
  const base = parseHexColor(PLANET_BASE_COLORS[p % PLANET_BASE_COLORS.length]);
  return parseHexColor(data?.[`plot_${p}_color`], base);
}

function axisValuesForPlot(p) {
  const out = [];
  for (let a = 0; a < 5; a++) {
    const k = `plot_${p}_axis_${a}`;
    const v = data?.[k];
    const n = typeof v === "number" && isFinite(v) ? v : 0;
    out.push(n);
  }
  return out;
}

function plotHasAllBands(p) {
  for (let a = 0; a < 5; a++) {
    const v = data?.[`plot_${p}_axis_${a}`];
    if (typeof v !== "number" || !isFinite(v)) return false;
  }
  return true;
}

function spiderRadiusMode() {
  const m = data?.__radiusMode;
  return String(m).toLowerCase() === "absolute" ? "absolute" : "relative";
}

function spiderDataLineDisplay() {
  const m = String(data?.__dataLineDisplay || "").toLowerCase().replace(/[^a-z]/g, "");
  return m === "powerbands" || m === "powerbandaxes" ? "powerBands" : "electrodes";
}

function spiderAbsoluteMean() {
  const v = data?.__absoluteMean;
  if (typeof v === "number" && isFinite(v)) return v;
  const n = parseFloat(String(v ?? ""));
  return isFinite(n) ? n : 0;
}

function spiderAbsoluteMax() {
  const v = data?.__absoluteMax;
  let x = typeof v === "number" && isFinite(v) ? v : parseFloat(String(v ?? ""));
  if (!isFinite(x) || x <= 1e-12) x = 1;
  return x;
}

function radiiForSpiderRelative(vals) {
  const abs = vals.map((v) => (typeof v === "number" && isFinite(v) ? Math.abs(v) : 0));
  let sum = 0;
  for (const x of abs) sum += x;
  if (sum > 1e-9) return abs.map((x) => x / sum);
  let mx = 0;
  for (const x of abs) mx = Math.max(mx, x);
  if (mx > 1e-9) return abs.map((x) => x / mx);
  return abs.map(() => 0.22);
}

function radiiForSpiderAbsolute(vals) {
  const mean = spiderAbsoluteMean();
  const maxAbs = spiderAbsoluteMax();
  if (maxAbs <= 1e-12) return radiiForSpiderRelative(vals);
  return vals.map((v) => {
    const n = typeof v === "number" && isFinite(v) ? v : 0;
    const t = Math.abs(n - mean) / maxAbs;
    return constrain(t, 0, 1);
  });
}

function radiiForSpider(vals) {
  if (spiderRadiusMode() === "absolute") return radiiForSpiderAbsolute(vals);
  return radiiForSpiderRelative(vals);
}

function polarPoint(angle, radius) {
  return {
    x: radius * cos(angle),
    y: radius * sin(angle),
  };
}

function pentagonPoint(i, scale) {
  const a = ROTATION + i * ANGLE;
  return polarPoint(a, RADIUS * scale);
}

function dataPolygonPoints(radii) {
  const pts = [];
  for (let i = 0; i < 5; i++) {
    const t = constrain(radii[i], 0.06, 1);
    pts.push(pentagonPoint(i, t));
  }
  return pts;
}

function dominantBandIndex(radii) {
  let best = 0;
  let bestV = -1;
  for (let i = 0; i < radii.length; i++) {
    if (radii[i] > bestV) {
      bestV = radii[i];
      best = i;
    }
  }
  return best;
}

function percentLabel(radii, i) {
  if (spiderRadiusMode() === "absolute") {
    return `${Math.round(constrain(radii[i], 0, 1) * 100)}%`;
  }
  const sum = radii.reduce((a, b) => a + b, 0);
  if (sum <= 1e-9) return "0%";
  return `${Math.round((radii[i] / sum) * 100)}%`;
}

function drawPentagonRing(scale, alpha, weight) {
  noFill();
  stroke(42, 42, 46, alpha);
  strokeWeight(weight);
  beginShape();
  for (let i = 0; i < 5; i++) {
    const p = pentagonPoint(i, scale);
    vertex(p.x, p.y);
  }
  endShape(CLOSE);
}

function drawPowerBandGrid() {
  for (const level of GRID_LEVELS) {
    drawPentagonRing(level, 95, 0.7);
  }
  drawPentagonRing(1, 120, 1);
  stroke(36, 36, 40, 110);
  strokeWeight(0.6);
  for (let i = 0; i < 5; i++) {
    const p = pentagonPoint(i, 1);
    line(0, 0, p.x, p.y);
  }
}

function drawGlowPolygon(points, alpha, weight, rgb) {
  noFill();
  stroke(rgb[0], rgb[1], rgb[2], alpha);
  strokeWeight(weight);
  beginShape();
  for (const p of points) vertex(p.x, p.y);
  endShape(CLOSE);
}

function drawBandDataPolygon(radii, fillAlpha) {
  const pts = dataPolygonPoints(radii);

  for (let layer = 0; layer < 3; layer++) {
    const t = 1 + layer * 0.06;
    const glowPts = pts.map((p, i) => {
      const a = ROTATION + i * ANGLE;
      const r = dist(0, 0, p.x, p.y) * t;
      return polarPoint(a, r);
    });
    const [r, g, b] = BAND_COLORS[dominantBandIndex(radii)];
    drawGlowPolygon(glowPts, 22 - layer * 5, 5 - layer, [r, g, b]);
  }

  beginShape();
  for (let i = 0; i < 5; i++) {
    const [r, g, b] = BAND_COLORS[i];
    fill(r, g, b, fillAlpha);
    stroke(r, g, b, 200);
    strokeWeight(1.2);
    vertex(pts[i].x, pts[i].y);
  }
  endShape(CLOSE);

  for (let i = 0; i < 5; i++) {
    const j = (i + 1) % 5;
    const [r, g, b] = BAND_COLORS[i];
    stroke(r, g, b, 240);
    strokeWeight(2);
    line(pts[i].x, pts[i].y, pts[j].x, pts[j].y);
  }

  for (let i = 0; i < 5; i++) {
    const [r, g, b] = BAND_COLORS[i];
    const p = pts[i];
    noStroke();
    fill(r, g, b, 55);
    circle(p.x, p.y, 18);
    fill(r, g, b, 110);
    circle(p.x, p.y, 10);
    fill(255, 255, 255, 245);
    circle(p.x, p.y, 3);
  }
}

function drawCenterDominant(radii) {
  const idx = dominantBandIndex(radii);
  const [r, g, b] = BAND_COLORS[idx];
  noStroke();
  fill(r, g, b, 18);
  circle(0, 0, 72);
  fill(r, g, b, 10);
  circle(0, 0, 96);

  fill(r, g, b, 255);
  textAlign(CENTER, CENTER);
  textSize(15);
  text(BAND_NAMES[idx], 0, -6);
  fill(120, 120, 128, 200);
  textSize(9);
  text("DOMINANT", 0, 12);
}

function drawBandLabels(radii) {
  textFont("Courier New");
  for (let i = 0; i < 5; i++) {
    const a = ROTATION + i * ANGLE;
    const p = polarPoint(a, LABEL_R);
    const [r, g, b] = BAND_COLORS[i];
    textAlign(CENTER, CENTER);
    noStroke();
    fill(r, g, b, 255);
    textSize(11);
    text(`${BAND_NAMES[i]}  ${percentLabel(radii, i)}`, p.x, p.y - 7);
    fill(95, 95, 102, 220);
    textSize(9);
    text(BAND_FREQ[i], p.x, p.y + 9);
  }
}

function drawElectrodeFrame() {
  noFill();
  stroke(42, 42, 46, 90);
  strokeWeight(0.8);
  for (const level of [0.35, 0.65, 1]) {
    circle(0, 0, RADIUS * 2 * level);
  }
  stroke(36, 36, 40, 90);
  for (let i = 0; i < EEG_RING_LABELS.length; i++) {
    const a = ROTATION + (TWO_PI * i) / EEG_RING_LABELS.length;
    const p = polarPoint(a, RADIUS);
    line(0, 0, p.x, p.y);
  }
}

function drawElectrodeLabels() {
  textSize(9);
  fill(120, 125, 135, 210);
  noStroke();
  textAlign(CENTER, CENTER);
  for (let i = 0; i < EEG_RING_LABELS.length; i++) {
    const a = ROTATION + (TWO_PI * i) / EEG_RING_LABELS.length;
    const p = polarPoint(a, RADIUS + 28);
    push();
    translate(p.x, p.y);
    rotate(a + HALF_PI);
    text(EEG_RING_LABELS[i], 0, 0);
    pop();
  }
}

function drawElectrodeSpider(radii, rgb, alpha) {
  const pts = dataPolygonPoints(radii);
  const [r, g, b] = rgb;
  drawGlowPolygon(pts, alpha * 0.35, 4, rgb);
  noFill();
  stroke(r, g, b, alpha);
  strokeWeight(1.8);
  beginShape();
  for (const p of pts) vertex(p.x, p.y);
  endShape(CLOSE);
}

windowResized = () => {
  resizeCanvas(windowWidth, windowHeight);
};

setup = () => {
  createCanvas(windowWidth, windowHeight);
  textFont("Courier New");
};

draw = () => {
  background(0);

  let nDraw = NUM_OVERLAY_PLOTS;
  if (typeof data?.__plotCount === "number" && isFinite(data.__plotCount)) {
    nDraw = Math.max(1, Math.min(12, Math.floor(data.__plotCount), NUM_OVERLAY_PLOTS));
  }

  push();
  translate(width / 2, height / 2);

  const dataLineDisplay = spiderDataLineDisplay();
  let visiblePlots = 0;
  let primaryRadii = null;

  if (dataLineDisplay === "powerBands") {
    drawPowerBandGrid();

    for (let p = nDraw - 1; p >= 0; p--) {
      if (!plotHasAllBands(p)) continue;
      const radii = radiiForSpider(axisValuesForPlot(p));
      const isPrimary = p === 0;
      if (isPrimary) primaryRadii = radii;
      if (isPrimary) {
        drawBandDataPolygon(radii, 48);
      } else {
        drawGlowPolygon(dataPolygonPoints(radii), 28, 1.2, planetColorForPlot(p));
      }
      visiblePlots++;
    }

    if (primaryRadii) {
      drawCenterDominant(primaryRadii);
      drawBandLabels(primaryRadii);
    }
  } else {
    drawElectrodeFrame();
    for (let p = 0; p < nDraw; p++) {
      if (!plotHasAllBands(p)) continue;
      const radii = radiiForSpider(axisValuesForPlot(p));
      drawElectrodeSpider(radii, planetColorForPlot(p), p === 0 ? 200 : 110);
      if (p === 0) primaryRadii = radii;
      visiblePlots++;
    }
    drawElectrodeLabels();
  }

  pop();

  textAlign(LEFT, TOP);
  noStroke();
  fill(70, 72, 78, 180);
  textSize(10);
  const mode = spiderRadiusMode();
  text(
    `${mode} · ${dataLineDisplay} · ${visiblePlots}/${nDraw} overlay(s) · cap ${NUM_OVERLAY_PLOTS}`,
    12,
    10
  );
};
