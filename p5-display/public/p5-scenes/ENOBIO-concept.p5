const MUSE_MARKERS = [
  { id: "TP9", position: [-68, -12, -32], radius: 5.0 },
  { id: "TP10", position: [68, -12, -32], radius: 5.0 },
  { id: "AF7", position: [-46, 60, 4], radius: 5.0 },
  { id: "AF8", position: [46, 70, 4], radius: 5.0 },
];

let brainModel;
let hudFont;
let autoRotation = 0;
let geodesicEdges = [];

function sceneRotationEnabled() {
  const raw = data?.rotation;
  if (raw === undefined || raw === null || raw === "") return true;
  if (typeof raw === "boolean") return raw;
  if (typeof raw === "number") return raw !== 0;

  const normalized = String(raw).trim().toLowerCase();
  if (["0", "false", "no", "off"].includes(normalized)) return false;
  if (["1", "true", "yes", "on"].includes(normalized)) return true;
  return true;
}

function hudScale() {
  return min(1.35, max(0.72, width / HUD_BAR_SCALE_REF));
}

function hudFontSize(basePx) {
  return max(7, basePx * hudScale());
}

function setHudFont() {
  if (hudFont) textFont(hudFont);
  else textFont(HUD_FONT);
}

function currentVisitorId() {
  const raw = data?.visitor ?? HUD_DEFAULT_VISITOR;
  const id = String(raw).trim() || HUD_DEFAULT_VISITOR;
  return VISITOR_PRESETS[id] ? id : HUD_DEFAULT_VISITOR;
}

function currentVisitorPreset() {
  return VISITOR_PRESETS[currentVisitorId()];
}

function currentMarkers() {
  return currentVisitorPreset().montage === "muse" ? MUSE_MARKERS : ENOBIO_MARKERS;
}

function currentBrainTint() {
  return currentVisitorPreset().color;
}

function geodesicEdgeKey(a, b) {
  return a < b ? `${a},${b}` : `${b},${a}`;
}

function normalizeVec3(v) {
  const len = Math.sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]) || 1;
  return [v[0] / len, v[1] / len, v[2] / len];
}

function buildGeodesicSphere(radius, subdivisions) {
  const t = (1 + Math.sqrt(5)) / 2;
  const verts = [
    [-1, t, 0],
    [1, t, 0],
    [-1, -t, 0],
    [1, -t, 0],
    [0, -1, t],
    [0, 1, t],
    [0, -1, -t],
    [0, 1, -t],
    [t, 0, -1],
    [t, 0, 1],
    [-t, 0, -1],
    [-t, 0, 1],
  ].map(normalizeVec3);

  let faces = [
    [0, 11, 5],
    [0, 5, 1],
    [0, 1, 7],
    [0, 7, 10],
    [0, 10, 11],
    [1, 5, 9],
    [5, 11, 4],
    [11, 10, 2],
    [10, 7, 6],
    [7, 1, 8],
    [3, 9, 4],
    [3, 4, 2],
    [3, 2, 6],
    [3, 6, 8],
    [3, 8, 9],
    [4, 9, 5],
    [2, 4, 11],
    [6, 2, 10],
    [8, 6, 7],
    [9, 8, 1],
  ];

  for (let s = 0; s < subdivisions; s++) {
    const midpointCache = new Map();
    const nextFaces = [];

    function midpoint(i, j) {
      const key = geodesicEdgeKey(i, j);
      if (midpointCache.has(key)) return midpointCache.get(key);
      const m = normalizeVec3([
        (verts[i][0] + verts[j][0]) / 2,
        (verts[i][1] + verts[j][1]) / 2,
        (verts[i][2] + verts[j][2]) / 2,
      ]);
      const idx = verts.length;
      verts.push(m);
      midpointCache.set(key, idx);
      return idx;
    }

    for (const [a, b, c] of faces) {
      const ab = midpoint(a, b);
      const bc = midpoint(b, c);
      const ca = midpoint(c, a);
      nextFaces.push([a, ab, ca], [b, bc, ab], [c, ca, bc], [ab, bc, ca]);
    }
    faces = nextFaces;
  }

  const edgeSet = new Set();
  for (const [a, b, c] of faces) {
    edgeSet.add(geodesicEdgeKey(a, b));
    edgeSet.add(geodesicEdgeKey(b, c));
    edgeSet.add(geodesicEdgeKey(c, a));
  }

  geodesicEdges = [];
  for (const key of edgeSet) {
    const [i, j] = key.split(",").map(Number);
    geodesicEdges.push([
      [verts[i][0] * radius, verts[i][1] * radius, verts[i][2] * radius],
      [verts[j][0] * radius, verts[j][1] * radius, verts[j][2] * radius],
    ]);
  }
}

function geodesicSphereEnabled() {
  if (typeof data?.show_geodesic_sphere === "boolean") return data.show_geodesic_sphere;
  if (typeof data?.show_geodesic_sphere === "number") return data.show_geodesic_sphere !== 0;
  const s = String(data?.show_geodesic_sphere ?? "").trim().toLowerCase();
  if (["0", "false", "no", "off"].includes(s)) return false;
  if (["1", "true", "yes", "on"].includes(s)) return true;
  return true;
}

function withScreenOverlay(drawFn) {
  push();
  camera();
  noLights();
  translate(-width / 2, -height / 2, 0);
  drawFn();
  pop();
}

function drawDiagonalStripes(x, y, w, h) {
  const spacing = HUD_STRIPE_SPACING * hudScale();
  stroke(...CYAN, CYAN_ALPHA.stripe);
  strokeWeight(1);
  const span = w + h;
  for (let d = -span; d < span; d += spacing) {
    line(x + d, y + h, x + d + h, y);
  }
}

function drawBorderRect(x, y, w, h, borderAlpha, fillAlpha) {
  if (fillAlpha > 0) {
    noStroke();
    fill(...CYAN, fillAlpha);
    rect(x, y, w, h);
  }
  noFill();
  stroke(...CYAN, borderAlpha);
  strokeWeight(1);
  rect(x, y, w, h);
}

function drawVisitorRow(contentX, contentW, y) {
  const preset = currentVisitorPreset();
  const rowH = HUD_VISITOR_ROW_H * hudScale();
  const lgSize = hudFontSize(HUD_FONT_VISITOR_LG);
  const smSize = hudFontSize(HUD_FONT_VISITOR_SM);
  const lgY = y + rowH * 0.38;
  const smY = y + rowH * 0.72;
  const [cr, cg, cb] = preset.color;

  drawBorderRect(contentX, y, contentW, rowH, CYAN_ALPHA.visitorBorder, CYAN_ALPHA.activeFill);

  setHudFont();
  noStroke();
  textAlign(CENTER, CENTER);
  textStyle(BOLD);
  textSize(lgSize);
  fill(cr, cg, cb, 255);
  text(preset.name, contentX + contentW / 2, lgY);

  textStyle(NORMAL);
  textSize(smSize);
  fill(...CYAN, 217);
  text(`${preset.device} · ${preset.channels}`, contentX + contentW / 2, smY);
  textStyle(NORMAL);
}

function drawToggleBarHeader() {
  if (!HUD_ENABLED) return;

  const s = hudScale();
  const barH = HUD_BAR_HEIGHT * s;
  const padX = HUD_PAD_X * s;
  const padY = HUD_PAD_Y * s;
  const contentW = min(HUD_CONTENT_MAX_W * s, width - padX * 2);
  const contentX = (width - contentW) / 2;
  const stripeW = width * HUD_STRIPE_W_FRAC;

  withScreenOverlay(() => {
    noStroke();
    fill(...HUD_BAR_BG);
    rect(0, 0, width, barH);

    drawDiagonalStripes(0, 0, stripeW, barH);
    drawDiagonalStripes(width - stripeW, 0, stripeW, barH);

    stroke(...CYAN, CYAN_ALPHA.barBorder);
    strokeWeight(1);
    line(0, 0, width, 0);
    line(0, barH, width, barH);

    drawVisitorRow(contentX, contentW, padY);
  });
}

preload = () => {
  brainModel = loadModel(BRAIN_MODEL_PATH, true);
  hudFont = loadFont(HUD_FONT_PATH);
};

windowResized = () => {
  resizeCanvas(windowWidth, windowHeight);
};

setup = () => {
  createCanvas(windowWidth, windowHeight, WEBGL);
  textAlign(CENTER, CENTER);
  colorMode(RGB, 255);
  buildGeodesicSphere(GEODESIC_RADIUS, GEODESIC_SUBDIVISIONS);
};

function withBrainTransform(drawFn) {
  push();
  rotateY(autoRotation);
  rotateX(SCENE_ROTATION_X);
  rotateY(SCENE_ROTATION_Y);
  scale(brainWorldScale());
  drawFn();
  pop();
}

function withBrainMeshTransform(drawFn) {
  withBrainTransform(() => {
    push();
    rotateX(BRAIN_MESH_ROTATION_X);
    rotateY(BRAIN_MESH_ROTATION_Y);
    rotateZ(BRAIN_MESH_ROTATION_Z);
    scale(BRAIN_MESH_SCALE);
    drawFn();
    pop();
  });
}

function brainWorldScale() {
  return Math.min(width, height) * BRAIN_SCALE;
}

function mapDataToIntensity(raw) {
  const n = constrain(raw, 0, 1);
  return DATA_INTENSITY_MIN + n * (DATA_INTENSITY_MAX - DATA_INTENSITY_MIN);
}

function updateMarkerDataState(markerId, value) {
  const now = millis();
  const state = markerDataState[markerId];
  if (!state) {
    markerDataState[markerId] = { lastValue: value, changedAt: now };
    return;
  }
  if (value !== state.lastValue) {
    state.lastValue = value;
    state.changedAt = now;
  }
}

function isMarkerDataFresh(markerId) {
  const state = markerDataState[markerId];
  if (!state) return false;
  return millis() - state.changedAt < DATA_STALE_MS;
}

function markerIntensity(marker) {
  const raw = data?.[marker.id];
  if (typeof raw !== "number" || !isFinite(raw)) {
    return MARKER_DEFAULT_INTENSITY;
  }
  const value = constrain(raw, 0, 1);
  updateMarkerDataState(marker.id, value);
  if (isMarkerDataFresh(marker.id)) {
    return mapDataToIntensity(value);
  }
  return MARKER_DEFAULT_INTENSITY;
}

function markerContactPosition(marker) {
  const [x, y, z] = marker.position;
  const c = Math.cos(MONTAGE_BACK_TILT_RADIANS);
  const s = Math.sin(MONTAGE_BACK_TILT_RADIANS);
  return [x + MONTAGE_OFFSET_X, y * c - z * s + MONTAGE_OFFSET_Y, y * s + z * c + MONTAGE_OFFSET_Z];
}

function markerLabelPosition(marker) {
  const [x, y, z] = markerContactPosition(marker);
  const mag = Math.sqrt(x * x + y * y + z * z) || 1;
  const offset = 20;
  return [x + (x / mag) * offset, y + (y / mag) * offset, z + (z / mag) * offset];
}

function markerColorFromIntensity(i) {
  const t = constrain(i, 0, 1);
  return [
    Math.round(lerp(MARKER_INTENSITY_WARM[0], MARKER_INTENSITY_HOT[0], t)),
    Math.round(lerp(MARKER_INTENSITY_WARM[1], MARKER_INTENSITY_HOT[1], t)),
    Math.round(lerp(MARKER_INTENSITY_WARM[2], MARKER_INTENSITY_HOT[2], t)),
    MARKER_ALPHA,
  ];
}

function drawBrainWireframe() {
  const [tr, tg, tb] = currentBrainTint();
  withBrainMeshTransform(() => {
    // noStroke();
    // ambientMaterial(...BRAIN_FILL);
    // specularMaterial(...BRAIN_SPECULAR);
    // shininess(BRAIN_SHININESS);
    // model(brainModel);

    noFill();
    stroke(tr, tg, tb, CYAN_ALPHA.wireframeOuter);
    strokeWeight(0.55);
    model(brainModel);
    stroke(tr, tg, tb, CYAN_ALPHA.wireframeInner);
    strokeWeight(0.35);
    model(brainModel);
  });
}

function drawGeodesicWireframe() {
  if (!geodesicSphereEnabled() || !geodesicEdges.length) return;
  const [tr, tg, tb] = currentBrainTint();
  withBrainTransform(() => {
    noFill();
    stroke(tr, tg, tb, GEODESIC_STROKE_ALPHA);
    strokeWeight(GEODESIC_STROKE_WEIGHT);
    for (const [[x1, y1, z1], [x2, y2, z2]] of geodesicEdges) {
      line(x1, y1, z1, x2, y2, z2);
    }
  });
}

function drawElectrodeMarkers() {
  withBrainTransform(() => {
    noStroke();
    for (const marker of currentMarkers()) {
      const i = markerIntensity(marker);
      if (i <= 0) continue;
      const [cx, cy, cz] = markerContactPosition(marker);
      const [r, g, b, a] = markerColorFromIntensity(i);
      const rad = marker.radius * (0.7 + i * 0.95);
      push();
      translate(cx, cy, cz);
      emissiveMaterial(r, g, b, a);
      sphere(rad, 10, 8);
      pop();
    }
  });
}

