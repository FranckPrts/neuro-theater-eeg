/* global WEBGL, CENTER, RGB, loadModel, loadFont, createCanvas, resizeCanvas, windowWidth, windowHeight */
/* global background, ambientLight, directionalLight, orbitControl, push, pop, rotateX, rotateY */
/* global scale, model, text, textAlign, textSize, noStroke, fill, noFill, constrain, millis, PI */
/* global translate, stroke, strokeWeight, line, sphere, rect, emissiveMaterial, colorMode */
/* global ambientMaterial, specularMaterial, shininess, lerp, rotateZ, textFont, textStyle, BOLD */
/* global camera, noLights, LEFT, RIGHT, CENTER, max, min, textWidth, textLeading */

// Head 3D model: Meshy AI low-poly human head (side-view export)
const BRAIN_MODEL_PATH = "p5-misc/glass-brain/human-head-low-poly.obj";
const HUD_FONT_PATH = "fonts/ShareTechMono-Regular.ttf";
const BRAIN_SCALE = 0.003;
const SCROLL_ZOOM_SENSITIVITY = 0.85;
// Shared scene orientation (head mesh, geodesic, electrodes, labels).
const SCENE_ROTATION_X = -Math.PI / 2 + Math.PI * 0.2;
const SCENE_ROTATION_Y = -Math.PI / 2 + Math.PI * 1.5;
// Extra mesh-only rotation (OBJ fine-tune; does not move electrodes or wireframe).
const BRAIN_MESH_ROTATION_X = Math.PI * 0.75;
const BRAIN_MESH_ROTATION_Y = 0;
const BRAIN_MESH_ROTATION_Z = 0;
const BRAIN_MESH_SCALE = 0.85; // mesh-only; 1 = full size, 0.9 = −10%
  
// ── VISUAL · palette ────────────────────────────────────────────────────────
const BG_COLOR = [0, 2, 8];
const HUD_BAR_BG = [0, 3, 8];
const CYAN = [0, 255, 153];

const CYAN_ALPHA = {
  barBorder: 46,
  visitorBorder: 255,
  labelText: 255,
  activeFill: 26,
  stripe: 10,
    wireframeOuter: 55,
  wireframeInner: 120,
  labelLine: 150,
  labelBox: 210,
  labelText: 235,
};

// ── VISUAL · header bar ───────────────────────────────────────────────────────
