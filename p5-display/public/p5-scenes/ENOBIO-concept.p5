draw = () => {
  background(...BG_COLOR);

  orbitControl(1, 1, SCROLL_ZOOM_SENSITIVITY);
  if (sceneRotationEnabled()) autoRotation += 0.004;

  ambientLight(...SCENE_AMBIENT);
  directionalLight(...SCENE_KEY, ...SCENE_KEY_DIR);

  drawGeodesicWireframe();
  drawBrainWireframe();
  drawElectrodeMarkers();
  // drawMarkerLabels();
  drawToggleBarHeader();
};
