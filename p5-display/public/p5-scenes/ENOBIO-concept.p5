const HUD_PAD_X = 12;
const HUD_PAD_Y = 10;
const HUD_STRIPE_W_FRAC = 0.24;
const HUD_STRIPE_SPACING = 7;
const HUD_VISITOR_ROW_H = 32;
const HUD_FONT = "Share Tech Mono";
const HUD_FONT_VISITOR_LG = 13;
const HUD_FONT_VISITOR_SM = 8;
const HUD_DEFAULT_VISITOR = "KANTOR";

const VISITOR_PRESETS = {
  KANTOR: { name: "KANTOR", montage: "enobio", device: "ENOBIO", channels: "32 CHANNELS", color: [184, 85, 255] },
  "1": { name: "Visitor 1", montage: "muse", device: "MUSE", channels: "4 CHANNELS", color: [255, 61, 74] },
  "2": { name: "Visitor 2", montage: "muse", device: "MUSE", channels: "4 CHANNELS", color: [255, 155, 61] },
  "3": { name: "Visitor 3", montage: "muse", device: "MUSE", channels: "4 CHANNELS", color: [255, 61, 155] },
  "4": { name: "Visitor 4", montage: "muse", device: "MUSE", channels: "4 CHANNELS", color: [61, 240, 160] },
  "5": { name: "Visitor 5", montage: "muse", device: "MUSE", channels: "4 CHANNELS", color: [230, 242, 74] },
  "6": { name: "Visitor 6", montage: "muse", device: "MUSE", channels: "4 CHANNELS", color: [61, 217, 240] },
};

// ── VISUAL · geodesic wireframe ─────────────────────────────────────────────
const GEODESIC_RADIUS = 132;
const GEODESIC_SUBDIVISIONS = 2;
const GEODESIC_STROKE_WEIGHT = 1;
const GEODESIC_STROKE_ALPHA = 40;

// ── VISUAL · brain mesh ───────────────────────────────────────────────────────
// const BRAIN_FILL = [12, 32, 30, 200];
// const BRAIN_SPECULAR = [0, 255, 153, 60];
// const BRAIN_SHININESS = 6;

// ── VISUAL · electrode markers ────────────────────────────────────────────────
const MARKER_INTENSITY_WARM = [248, 238, 195];
const MARKER_INTENSITY_HOT = [255, 95, 48];
const MARKER_ALPHA = 50; // ~20% opacity (RGB 0–255)

// ── VISUAL · scene lighting ───────────────────────────────────────────────────
const SCENE_AMBIENT = [28, 42, 38];
const SCENE_KEY = [72, 120, 100];
const SCENE_KEY_DIR = [0.25, 0.45, -1];

// ── DATA · marker intensity ───────────────────────────────────────────────────
const DATA_INTENSITY_MIN = 0.1;
const DATA_INTENSITY_MAX = 0.5;
const MARKER_DEFAULT_INTENSITY = 0.5;
const DATA_STALE_MS = 2000;

const markerDataState = {};
const MONTAGE_BACK_TILT_RADIANS = Math.PI / 6;
const MONTAGE_OFFSET_X = 0;
const MONTAGE_OFFSET_Y = -10;
const MONTAGE_OFFSET_Z = 10;

const ENOBIO_MARKERS = [
