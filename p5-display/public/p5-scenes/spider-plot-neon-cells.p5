/**
 * Spider / radar plot — neon cell grid with one device per cell.
 *
 * Radius mode (from host `data`): `__radiusMode` — `relative` (default) or `absolute`.
 * Absolute scale: `__absoluteMean` (branch value at center), `__absoluteMax` (|v−mean| at outer edge).
 *
 * Max mappable overlays (OSC rail size). Server reads this exact line for /api/p5-scenes:
 *   const NUM_OVERLAY_PLOTS = 6;
 */
const NUM_OVERLAY_PLOTS = 6;

const ANGLE = (2 * Math.PI) / 5;
const AXIS_LABELS = ["Delta", "Theta", "Alpha", "Low β", "High β"];
const AXIS_SHORT_LABELS = ["D", "T", "A", "lB", "hB"];
const PLANET_BASE_COLORS = [
  "#F53645",
  "#F5A636",
  "#D0F536",
  "#36F563",
  "#36E3F5",
  "#3647F5",
  "#A136F5"
];
const ROTATION = -Math.PI / 2;
const CURVE_STEPS = 180;

function parseHexColor(h, fallback = [120, 160, 200]) {
  if (typeof h !== "string") return fallback;
  let s = h.trim();
  if (s.startsWith("0x")) s = "#" + s.slice(2);
  if (!s.startsWith("#")) s = "#" + s;
  const hex = s.slice(1);
  if (hex.length === 3) {
    const r = parseInt(hex[0] + hex[0], 16);
    const g = parseInt(hex[1] + hex[1], 16);
    const b = parseInt(hex[2] + hex[2], 16);
    if ([r, g, b].every((x) => !isNaN(x))) return [r, g, b];
  }
  if (hex.length === 6) {
    const r = parseInt(hex.slice(0, 2), 16);
    const g = parseInt(hex.slice(2, 4), 16);
    const b = parseInt(hex.slice(4, 6), 16);
    if ([r, g, b].every((x) => !isNaN(x))) return [r, g, b];
  }
  return fallback;
}

function planetColorForPlot(p) {
  const base = parseHexColor(PLANET_BASE_COLORS[p % PLANET_BASE_COLORS.length]);
  return parseHexColor(data?.[`plot_${p}_color`], base);
}

function axisValuesForPlot(p) {
  const out = [];
  for (let a = 0; a < 5; a++) {
    const k = `plot_${p}_axis_${a}`;
    const v = data?.[k];
    const n = typeof v === "number" && isFinite(v) ? v : 0;
    out.push(n);
  }
  return out;
}

function plotHasAllBands(p) {
  for (let a = 0; a < 5; a++) {
    const v = data?.[`plot_${p}_axis_${a}`];
    if (typeof v !== "number" || !isFinite(v)) return false;
  }
  return true;
}

function spiderRadiusMode() {
  const m = data?.__radiusMode;
  return String(m).toLowerCase() === "absolute" ? "absolute" : "relative";
}

function spiderAbsoluteMean() {
  const v = data?.__absoluteMean;
  if (typeof v === "number" && isFinite(v)) return v;
  const n = parseFloat(String(v ?? ""));
  return isFinite(n) ? n : 0;
}

/** Positive span from mean to outer pentagon edge; invalid/zero falls back to 1. */
function spiderAbsoluteMax() {
  const v = data?.__absoluteMax;
  let x = typeof v === "number" && isFinite(v) ? v : parseFloat(String(v ?? ""));
  if (!isFinite(x) || x <= 1e-12) x = 1;
  return x;
}

/** Relative: share of total |v| per axis (legacy). */
function radiiForSpiderRelative(vals) {
  const abs = vals.map((v) => (typeof v === "number" && isFinite(v) ? Math.abs(v) : 0));
  let sum = 0;
  for (const x of abs) sum += x;
  if (sum > 1e-9) return abs.map((x) => x / sum);
  let mx = 0;
  for (const x of abs) mx = Math.max(mx, x);
  if (mx > 1e-9) return abs.map((x) => x / mx);
  return abs.map(() => 0.22);
}

/** Absolute: distance from shared mean, scaled so |v - mean| === max hits the outer radius. */
function radiiForSpiderAbsolute(vals) {
  const mean = spiderAbsoluteMean();
  const maxAbs = spiderAbsoluteMax();
  if (maxAbs <= 1e-12) return radiiForSpiderRelative(vals);
  return vals.map((v) => {
    const n = typeof v === "number" && isFinite(v) ? v : 0;
    const t = Math.abs(n - mean) / maxAbs;
    return constrain(t, 0, 1);
  });
}

/** Map 5 raw values to [0,1] radii — mode from host (`data.__radiusMode`). */
function radiiForSpider(vals) {
  if (spiderRadiusMode() === "absolute") return radiiForSpiderAbsolute(vals);
  return radiiForSpiderRelative(vals);
}

function rgbaString(rgb, alpha) {
  const [r, g, b] = rgb;
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

function setGlow(rgb, blur, alpha) {
  drawingContext.shadowBlur = blur;
  drawingContext.shadowColor = rgbaString(rgb, alpha);
}

function clearGlow() {
  drawingContext.shadowBlur = 0;
  drawingContext.shadowColor = "rgba(0, 0, 0, 0)";
}

function polarPoint(angle, radius) {
  return {
    x: radius * cos(angle),
    y: radius * sin(angle)
  };
}

function easedLerp(a, b, t) {
  const u = t * t * (3 - 2 * t);
  return lerp(a, b, u);
}

function pointOnSpider(radii, phase, baseRadius, scale, rotationOffset, ripple) {
  const wrapped = ((phase % 5) + 5) % 5;
  const i = Math.floor(wrapped);
  const j = (i + 1) % 5;
  const local = wrapped - i;
  const base = easedLerp(radii[i], radii[j], local);
  const angle = ROTATION + wrapped * ANGLE + rotationOffset;
  const shimmer = 1 + ripple * sin(wrapped * TWO_PI * 2 + frameCount * 0.018);
  return polarPoint(angle, base * baseRadius * scale * shimmer);
}

function drawClosedCurve(points, rgb, alpha, weight, glow) {
  noFill();
  setGlow(rgb, glow, alpha / 255);
  stroke(rgb[0], rgb[1], rgb[2], alpha);
  strokeWeight(weight);
  beginShape();
  const n = points.length;
  for (let i = -2; i < n + 3; i++) {
    const p = points[(i + n) % n];
    curveVertex(p.x, p.y);
  }
  endShape(CLOSE);
  clearGlow();
}

function drawCellFrame(x, y, w, h, rgb, active) {
  const r = 9;
  noFill();
  strokeWeight(active ? 1.15 : 0.8);
  stroke(rgb[0], rgb[1], rgb[2], active ? 145 : 45);
  setGlow(rgb, active ? 14 : 5, active ? 0.32 : 0.08);
  rect(x, y, w, h, r);
  clearGlow();

  fill(10, 16, 24, 210);
  noStroke();
  rect(x + 1, y + 1, w - 2, h - 2, r - 1);
}

function drawPanogramFrame(baseRadius) {
  noFill();

  for (let r = 0.28; r <= 1.001; r += 0.18) {
    stroke(120, 126, 138, r > 0.95 ? 94 : 36);
    strokeWeight(1);
    circle(0, 0, baseRadius * 2 * r);
  }

  stroke(105, 111, 124, 58);
  strokeWeight(1);
  for (let i = 0; i < 5; i++) {
    const p = polarPoint(ROTATION + i * ANGLE, baseRadius);
    line(0, 0, p.x, p.y);
  }

  stroke(178, 184, 197, 115);
  strokeWeight(1.4);
  circle(0, 0, baseRadius * 2);
}

function drawAxisLabels(baseRadius) {
  textAlign(CENTER, CENTER);
  noStroke();
  textSize(max(8, min(11, baseRadius * 0.14)));
  fill(170, 176, 190, 175);
  for (let i = 0; i < 5; i++) {
    const p = polarPoint(ROTATION + i * ANGLE, baseRadius * 1.2);
    text(AXIS_LABELS[i], p.x, p.y);
  }
}

function drawNeonSpider(radii, rgb, plotIndex, baseRadius) {
  const softened = radii.map((r) => constrain(0.18 + r * 0.88, 0.06, 1.08));
  const echoCount = 18;
  const seed = plotIndex * 0.73;

  for (let e = echoCount - 1; e >= 0; e--) {
    const t = e / (echoCount - 1);
    const scale = 0.68 + t * 0.46;
    const rotationOffset = sin(frameCount * 0.006 + seed + e * 0.49) * 0.09;
    const ripple = 0.012 + t * 0.025;
    const points = [];

    for (let s = 0; s < CURVE_STEPS; s++) {
      const phase = (s / CURVE_STEPS) * 5;
      points.push(pointOnSpider(softened, phase, baseRadius, scale, rotationOffset, ripple));
    }

    const alpha = 18 + t * 68;
    const weight = 0.8 + t * 2.2;
    drawClosedCurve(points, rgb, alpha, weight, 14 + t * 20);
  }

  const corePoints = [];
  for (let s = 0; s < CURVE_STEPS; s++) {
    const phase = (s / CURVE_STEPS) * 5;
    corePoints.push(pointOnSpider(softened, phase, baseRadius, 1.0, 0, 0.008));
  }
  drawClosedCurve(corePoints, rgb, 230, 4.2, 28);
  drawClosedCurve(corePoints, [255, 255, 210], 98, 1.4, 18);
}

function normalizedBarsForValues(vals) {
  if (spiderRadiusMode() === "absolute") return radiiForSpiderAbsolute(vals);
  const abs = vals.map((v) => (typeof v === "number" && isFinite(v) ? Math.abs(v) : 0));
  let mx = 0;
  for (const x of abs) mx = Math.max(mx, x);
  if (mx <= 1e-9) return abs.map(() => 0);
  return abs.map((x) => constrain(x / mx, 0, 1));
}

function drawBandPlot(x, y, w, h, vals, rgb, active) {
  const bars = active ? normalizedBarsForValues(vals) : [0, 0, 0, 0, 0];
  const gap = max(3, w * 0.016);
  const barW = (w - gap * 4) / 5;
  const labelH = min(14, h * 0.32);
  const trackH = h - labelH - 3;

  noStroke();
  fill(42, 50, 64, active ? 190 : 90);
  rect(x, y + trackH - 1, w, 2);

  for (let i = 0; i < 5; i++) {
    const bx = x + i * (barW + gap);
    const bh = max(2, bars[i] * trackH);
    const by = y + trackH - bh;

    fill(rgb[0], rgb[1], rgb[2], active ? 55 : 18);
    rect(bx, y + trackH * 0.28, barW, trackH * 0.72, 1);

    fill(rgb[0], rgb[1], rgb[2], active ? 218 : 54);
    setGlow(rgb, active ? 8 : 0, active ? 0.22 : 0);
    rect(bx, by, barW, bh, 1);
    clearGlow();

    fill(152, 165, 184, active ? 190 : 75);
    textAlign(CENTER, TOP);
    textSize(9);
    text(AXIS_SHORT_LABELS[i], bx + barW / 2, y + trackH + 3);
  }
}

function drawEmptyHint(cx, cy) {
  noStroke();
  fill(132, 142, 160, 92);
  textAlign(CENTER, CENTER);
  textSize(10);
  text("map bands", cx, cy);
}

function drawDeviceCell(p, x, y, w, h) {
  const rgb = planetColorForPlot(p);
  const active = plotHasAllBands(p);
  const vals = axisValuesForPlot(p);
  const radii = active ? radiiForSpider(vals) : [0.18, 0.18, 0.18, 0.18, 0.18];
  const pad = max(10, min(w, h) * 0.055);
  const plotH = h * 0.25;
  const spiderAreaH = h - plotH - pad * 2.35;
  const cx = x + w / 2;
  const cy = y + pad + spiderAreaH * 0.52;
  const baseRadius = min((w - pad * 2) * 0.42, spiderAreaH * 0.47);

  drawCellFrame(x, y, w, h, rgb, active);

  push();
  translate(cx, cy);
  drawPanogramFrame(baseRadius);
  if (active) {
    blendMode(ADD);
    drawNeonSpider(radii, rgb, p, baseRadius);
    blendMode(BLEND);
  } else {
    drawEmptyHint(0, 0);
  }
  drawAxisLabels(baseRadius);
  pop();

  drawBandPlot(x + pad, y + h - plotH - pad * 0.7, w - pad * 2, plotH, vals, rgb, active);
}

function scenePlotCount() {
  let nDraw = NUM_OVERLAY_PLOTS;
  if (typeof data?.__plotCount === "number" && isFinite(data.__plotCount)) {
    nDraw = Math.max(1, Math.min(12, Math.floor(data.__plotCount), NUM_OVERLAY_PLOTS));
  }
  return nDraw;
}

windowResized = () => {
  resizeCanvas(windowWidth, windowHeight);
};

setup = () => {
  createCanvas(windowWidth, windowHeight);
  textFont("Courier New");
};

draw = () => {
  background(0);

  const nDraw = scenePlotCount();
  const cols = 3;
  const rows = 2;
  const outerGap = max(9, min(width, height) * 0.025);
  const gap = max(10, min(width, height) * 0.025);
  const cellW = (width - outerGap * 2 - gap * (cols - 1)) / cols;
  const cellH = (height - outerGap * 2 - gap * (rows - 1)) / rows;

  for (let p = 0; p < NUM_OVERLAY_PLOTS; p++) {
    const col = p % cols;
    const row = Math.floor(p / cols);
    const x = outerGap + col * (cellW + gap);
    const y = outerGap + row * (cellH + gap);
    drawDeviceCell(p, x, y, cellW, cellH);
  }

  if (nDraw < NUM_OVERLAY_PLOTS) {
    noStroke();
    fill(0, 0, 0, 115);
    for (let p = nDraw; p < NUM_OVERLAY_PLOTS; p++) {
      const col = p % cols;
      const row = Math.floor(p / cols);
      const x = outerGap + col * (cellW + gap);
      const y = outerGap + row * (cellH + gap);
      rect(x + 1, y + 1, cellW - 2, cellH - 2, 8);
    }
  }
};
