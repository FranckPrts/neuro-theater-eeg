// Multi-channel view — reads fixed keys ch0..ch5 from `data` (mapped from OSC in the host).
const bgColor = [220, 220, 220];
const signalColor = [0, 0, 0];
const fontSize = 14;
const signalStroke = 1;
const trimRange = false;

const CHANNEL_IDS = ["ch0", "ch1", "ch2", "ch3", "ch4", "ch5"];

function drawTimeSeries(ts, xOffset, lowerbound, upperbound) {
  beginShape();
  for (let i = 0; i < windowWidth && i < ts.length; i++) {
    let v = ts[ts.length - i - 1];
    if (trimRange) v = constrain(v, minimum, maximum);
    vertex(xOffset - i, map(v, minimum, maximum, upperbound, lowerbound));
  }
  endShape();
}

windowResized = () => {
  resizeCanvas(windowWidth, windowHeight);
};

let minimum = -0.5;
let maximum = 1.5;
const ts_channels = CHANNEL_IDS.map(() => []);

setup = () => {
  createCanvas(windowWidth, windowHeight);
  textSize(fontSize);
  textFont("Courier New");
};

draw = () => {
  background(...bgColor);

  const active = [];
  for (let k = 0; k < CHANNEL_IDS.length; k++) {
    const id = CHANNEL_IDS[k];
    const raw = data?.[id];
    if (raw !== undefined && raw !== null && typeof raw === "number" && isFinite(raw)) {
      ts_channels[k].push(raw);
      if (ts_channels[k].length > width) {
        ts_channels[k].shift();
      }
    }
    if (ts_channels[k].length >= 2) {
      active.push(k);
    }
  }

  const n = active.length;
  if (n === 0) {
    fill(100, 100, 110);
    noStroke();
    textAlign(CENTER, CENTER);
    text("Map OSC streams to ch0–ch5", width / 2, height / 2);
    return;
  }

  for (let ai = 0; ai < n; ai++) {
    const k = active[ai];
    const id = CHANNEL_IDS[k];
    const ts = ts_channels[k];
    if (ts.length < 2) continue;

    const y0 = (ai * height) / n;
    const y1 = ((ai + 1) * height) / n;

    noFill();
    stroke(...signalColor);
    strokeWeight(signalStroke);
    drawTimeSeries(ts, width, y0, y1);

    fill(...signalColor);
    strokeWeight(4);
    stroke(...bgColor);
    textAlign(LEFT, CENTER);
    text(id, 10, (y0 + y1) / 2);
    stroke(...signalColor);
    strokeWeight(signalStroke);
  }
};
